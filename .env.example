# Copy this file to .env and adjust. Every setting is optional.

# Folder to index. Relative paths are relative to this project folder.
# Default "data" = the data/ folder inside this repo. Can be any path, e.g. D:/College Notes
DOCTRACE_DATA_DIR=data

# Where the index is stored (safe to delete; rebuild with `python ingest.py`)
DOCTRACE_INDEX_DIR=vector_db

# Embedding model (changing it triggers a full re-index).
# Multilingual alternative: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DOCTRACE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCTRACE_CHUNK_SIZE=1000
DOCTRACE_CHUNK_OVERLAP=150
DOCTRACE_MAX_FILE_MB=200
# DOCTRACE_WORKERS=4

# OCR for images and scanned PDFs: auto (use it if Tesseract is installed) | on | off
DOCTRACE_OCR=auto
# Needed only if tesseract is not on PATH, e.g. C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=

# Answer generation: auto (use Ollama if available) | ollama | none (search only)
DOCTRACE_LLM=auto
OLLAMA_URL=http://localhost:11434
# llama3.2 (3B, ~2 GB) runs on most laptops. Bigger / better: mistral, llama3.1:8b, qwen2.5:7b
OLLAMA_MODEL=llama3.2
# Start `ollama serve` automatically if Ollama is installed but not running
OLLAMA_AUTOSTART=1

# Web UI (if the port is busy the next free one is used)
DOCTRACE_HOST=127.0.0.1
DOCTRACE_PORT=7860
# Show "Open file" / "Show in folder" buttons (only when the UI runs on localhost)
DOCTRACE_ALLOW_OPEN=1
# While the app is open, re-scan the data folder every N minutes (0 = only when you click "Update index")
DOCTRACE_WATCH_MINUTES=0

# Optional Google Drive source (`python ingest.py --gdrive`, needs requirements-gdrive.txt)
GDRIVE_FOLDER_ID=
GDRIVE_CREDENTIALS=service_account.json
