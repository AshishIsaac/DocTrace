# Keep secrets, your documents and local state out of the Docker image
# (data/ and the index are mounted as volumes instead - see docker-compose.yml)

# secrets
.env
.env.*
!.env.example
service_account.json
*service_account*.json
*service-account*.json
*credentials*.json
client_secret*.json
token.json
token.pickle
*.pem
*.key
*.p12
*.pfx

